# Copy to .env.local for local development. On Vercel, set these in Project -> Settings -> Environment Variables.

# Postgres connection string. Local: printed by `npm run db:local`. Vercel: the Neon pooled URL.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/walletops

# Password for the dashboard login (single admin user).
ADMIN_PASSWORD=change-me

# Secret used to sign the login session cookie. At least 32 random characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Key that callers of the public wallet API must send in the `x-api-key` header.
WALLET_API_KEY=dev-wallet-key

# Secret for the generator tick endpoint (`Authorization: Bearer <CRON_SECRET>`).
# Vercel Cron and the GitHub Actions schedule both use it.
CRON_SECRET=dev-cron-secret
